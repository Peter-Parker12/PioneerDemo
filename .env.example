# Optional. Without a key the app runs in demo mode: every built-in demo item (sample claim pack, sample receipts,
# assistant suggestions) still works with animations. A key adds live reading of your own uploads and free-form chat.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: model override (default claude-sonnet-5-5)
# CLAUDE_MODEL=claude-sonnet-5-5
# Optional: force demo mode even when a key is set (fast, no API cost)
# DEMO_MODE=1
